{
  "manifest_version": 3,
  "name": "Shadow Glade Theme",
  "version": "1.0.0",
  "description": "A cool retro Chrome theme in ink navy and pale mint — dark glade chrome over a light meadow page.",
  "icons": {
    "128": "logo/logo.png"
  },
  "theme": {
    "colors": {
      "frame":                        [32, 39, 52],
      "frame_inactive":               [43, 52, 68],
      "toolbar":                      [54, 65, 90],
      "tab_text":                     [224, 248, 199],
      "bookmark_text":                [224, 248, 199],
      "ntp_background":               [224, 248, 199],
      "ntp_text":                     [34, 48, 42],
      "ntp_link":                     [47, 93, 58],
      "ntp_header":                   [183, 216, 148],
      "button_background":            [183, 216, 148],
      "button_background_secondary":  [54, 65, 90],
      "omnibox_background":           [242, 251, 234],
      "toolbar_button_icon":          [224, 248, 199]
    },
    "properties": {
      "ntp_button_background":    [54, 65, 90],
      "ntp_button_hover":         [43, 52, 68],
      "ntp_logo_alternate":       1,
      "ntp_single_row_shortcuts": true
    },
    "color_scheme": "light",
    "default_color_scheme": "light"
  }
}
